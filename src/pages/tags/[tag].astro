---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const rawNotes = await getCollection('notes');
  const rawReports = await getCollection('reports');

  const notes = rawNotes.filter((p) => !p.data.draft).map((p) => ({
    title: p.data.title,
    description: p.data.description,
    date: p.data.date,
    slug: p.id,
    category: p.data.category,
    tags: p.data.tags,
    collectionType: 'notes' as const,
    body: p.body || '',
    featured: p.data.featured,
  }));

  const reports = rawReports.filter((p) => !p.data.draft).map((p) => ({
    title: p.data.title,
    description: p.data.description,
    date: p.data.date,
    slug: p.id,
    category: p.data.category,
    tags: p.data.tags,
    collectionType: 'reports' as const,
    body: p.body || '',
    featured: false,
  }));

  const allPosts = [...notes, ...reports];
  const allTags = Array.from(new Set(allPosts.flatMap((p) => p.tags)));

  return allTags.map((tag) => {
    const filteredPosts = allPosts.filter((p) => p.tags.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts, tag },
    };
  });
}

const { posts, tag } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;

const searchItems = posts.map((p) => ({
  title: p.title,
  description: p.description,
  url: `${baseUrl}/${p.collectionType}/${p.slug}`,
  category: p.category,
  tags: p.tags,
  date: new Date(p.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
}));
---

<BaseLayout title={`#${tag}`} description={`Posts tagged with #${tag}`} searchPosts={searchItems}>
  <!-- Header -->
  <div class="py-8 border-b border-[var(--border-card)] mb-8">
    <a 
      href={`${baseUrl}/`} 
      class="inline-flex items-center gap-2 text-sm text-[var(--text-secondary)] hover:text-sky-400 mb-4 group transition-colors"
    >
      <svg class="group-hover:-translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>All Topics</span>
    </a>

    <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text-primary)] mb-2 flex items-center gap-3">
      <span>Tag:</span>
      <span class="text-sky-400">#{tag}</span>
    </h1>
    <p class="text-[var(--text-secondary)] text-sm sm:text-base">
      Found {posts.length} {posts.length === 1 ? 'entry' : 'entries'} matching this tag.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {posts.map((post) => (
      <PostCard {...post} />
    ))}
  </div>
</BaseLayout>
