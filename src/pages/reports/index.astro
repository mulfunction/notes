---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const rawReports = await getCollection('reports');
const reports = rawReports
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;

const searchItems = reports.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  url: `${baseUrl}/reports/${p.id}`,
  category: p.data.category,
  tags: p.data.tags,
  date: new Date(p.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
}));
---

<BaseLayout title="Weekly Reports" description="Archive of weekly project progress reports and updates." searchPosts={searchItems}>
  <div class="py-8 border-b border-[var(--border-card)] mb-8">
    <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text-primary)] mb-2">
      Weekly Reports
    </h1>
    <p class="text-[var(--text-secondary)] text-sm sm:text-base">
      Weekly summaries tracking progress, key metrics, and architectural decisions.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {reports.map((post) => (
      <PostCard 
        title={post.data.title}
        description={post.data.description}
        date={post.data.date}
        slug={post.id}
        category={post.data.category}
        tags={post.data.tags}
        collectionType="reports"
        body={post.body || ''}
      />
    ))}
  </div>
</BaseLayout>
