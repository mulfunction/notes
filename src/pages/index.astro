---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const rawNotes = await getCollection('notes');
const rawReports = await getCollection('reports');

const notes = rawNotes.filter((p) => !p.data.draft).map((p) => ({
  title: p.data.title,
  description: p.data.description,
  date: p.data.date,
  slug: p.id,
  category: p.data.category,
  tags: p.data.tags,
  collectionType: 'notes' as const,
  body: p.body || '',
  featured: p.data.featured,
}));

const reports = rawReports.filter((p) => !p.data.draft).map((p) => ({
  title: p.data.title,
  description: p.data.description,
  date: p.data.date,
  slug: p.id,
  category: p.data.category,
  tags: p.data.tags,
  collectionType: 'reports' as const,
  body: p.body || '',
  featured: false,
}));

const allPosts = [...notes, ...reports].sort(
  (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf()
);

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;

const searchItems = allPosts.map(p => ({
  title: p.title,
  description: p.description,
  url: `${baseUrl}/${p.collectionType}/${p.slug}`,
  category: p.category,
  tags: p.tags,
  date: new Date(p.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
}));

const allTags = Array.from(new Set(allPosts.flatMap(p => p.tags)));
---

<BaseLayout title="Home" searchPosts={searchItems}>
  <!-- Hero Section -->
  <section class="py-8 sm:py-12 border-b border-[var(--border-card)] mb-10">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/30 mb-4">
        <span>Obsidian Synced</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-green)] animate-pulse"></span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] mb-4">
        Notes, Logs & Reports
      </h1>
      <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed">
        A personal Gruvbox-themed digital notebook for weekly project progress reports, technical logs, software patterns, and architectural guides.
      </p>

      <!-- Quick Stats -->
      <div class="mt-8 flex flex-wrap items-center gap-6 text-sm text-[var(--text-secondary)]">
        <div>
          <span class="font-bold text-[var(--accent)] text-lg">{allPosts.length}</span> Total Posts
        </div>
        <div>
          <span class="font-bold text-[var(--accent-green)] text-lg">{reports.length}</span> Weekly Reports
        </div>
        <div>
          <span class="font-bold text-[var(--accent-purple)] text-lg">{notes.length}</span> Tech Notes
        </div>
      </div>
    </div>
  </section>

  <!-- Tag Filter Cloud -->
  <section class="mb-10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xs font-semibold tracking-wider uppercase text-[var(--text-secondary)]">
        Filter by Tag
      </h2>
    </div>
    <div class="flex flex-wrap gap-2">
      {allTags.map((tag) => (
        <a 
          href={`${baseUrl}/tags/${tag}`}
          class="px-3 py-1 rounded-lg text-xs font-medium bg-[var(--bg-card)] border border-[var(--border-card)] text-[var(--text-secondary)] hover:text-[var(--accent)] hover:border-[var(--accent)]/50 transition-all duration-200"
        >
          #{tag}
        </a>
      ))}
    </div>
  </section>

  <!-- Posts Bento Grid -->
  <section>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold tracking-tight text-[var(--text-primary)]">
        Recent Entries
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {allPosts.map((post) => (
        <PostCard {...post} />
      ))}
    </div>
  </section>
</BaseLayout>
