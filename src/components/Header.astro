---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-[var(--bg-main)]/80 border-b border-[var(--border-card)] transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={`${baseUrl}/`} class="flex items-center space-x-3 group">
      <img 
        src={`${baseUrl}/logo.jpeg`} 
        alt="Muldan Logo" 
        class="w-9 h-9 rounded-full object-cover border border-sky-500/30 group-hover:scale-105 transition-transform duration-300 shadow-sm"
      />
      <span class="font-bold text-lg tracking-tight text-[var(--text-primary)] group-hover:text-sky-400 transition-colors">
        Notes & Reports
      </span>
    </a>

    <!-- Nav Items & Action Buttons -->
    <nav class="flex items-center space-x-2 sm:space-x-4">
      <a href={`${baseUrl}/`} class="px-3 py-1.5 rounded-lg text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-white/5 transition-colors">
        All
      </a>
      <a href={`${baseUrl}/reports`} class="px-3 py-1.5 rounded-lg text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-white/5 transition-colors">
        Weekly Reports
      </a>
      <a href={`${baseUrl}/notes`} class="px-3 py-1.5 rounded-lg text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-white/5 transition-colors">
        Notes
      </a>

      <!-- Search Trigger Button -->
      <button 
        id="open-search" 
        type="button" 
        class="p-2 text-[var(--text-secondary)] hover:text-[var(--text-primary)] rounded-lg hover:bg-white/5 transition-colors focus:outline-none"
        aria-label="Search posts"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Dark / Light Theme Toggle -->
      <button 
        id="theme-toggle" 
        type="button" 
        class="p-2 text-[var(--text-secondary)] hover:text-[var(--text-primary)] rounded-lg hover:bg-white/5 transition-colors focus:outline-none"
        aria-label="Toggle theme"
      >
        <svg id="theme-icon-sun" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg id="theme-icon-moon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
