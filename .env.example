# ------------------------------------------------------------------------------
# OBSIDIAN PATH
# ------------------------------------------------------------------------------
# Set the absolute path to your Obsidian media folder.
# If left blank, the script will attempt to auto-detect based on your OS.
# 
# Windows Example: C:/Users/ASUSC/Documents/Obsidian/Muldan-Second-Brain/media
# Linux Example: /home/muldan/Obsidian/Muldan-Second-Brain/media
OBSIDIAN_MEDIA_PATH=

# ------------------------------------------------------------------------------
# CLOUD STORAGE (Optional for offloading images from GitHub)
# ------------------------------------------------------------------------------
# If you set CLOUD_BUCKET_URL, the remark-obsidian plugin will point image tags
# to this domain instead of your local public/images folder.
# Example: https://pub-xxxxxxxxxxxxxx.r2.dev/images
CLOUD_BUCKET_URL=

# If you implement the auto-upload script (e.g. for AWS S3 / Cloudflare R2),
# you will need credentials:
# CLOUD_API_KEY=
# CLOUD_API_SECRET=
# CLOUD_BUCKET_NAME=
